# Required in production (Vercel sets NODE_ENV=production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Hosted SQLite (Turso). Required on Vercel. Leave both unset to use data/gardez.db on your machine.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Optional. Overrides the local database file. Ignored when TURSO_DATABASE_URL is set.
# DATABASE_FILE=data/gardez.db
